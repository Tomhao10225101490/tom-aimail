# Tom AImail configuration — copy to ".env" and fill in your own values.
# .env is gitignored: your secrets never leave this machine.

# The mailbox that receives requests (QQ Mail by default).
MAIL_ADDRESS=you@qq.com
# QQ Mail authorization code (Settings -> Account -> IMAP/SMTP service).
# This is NOT your QQ password.
MAIL_AUTH_CODE=replace-with-your-qq-mail-auth-code
IMAP_HOST=imap.qq.com
SMTP_HOST=smtp.qq.com

# DeepSeek API (OpenAI-compatible).
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Seconds between inbox checks in polling mode.
POLL_SECONDS=120
# Optional: comma-separated sender allowlist. Empty = serve everyone.
ALLOWED_SENDERS=
# Max characters of extracted document text sent to the AI.
MAX_DOC_CHARS=60000
# Local file remembering who has written to us before (for the welcome line).
STATE_FILE=.tom-aimail-state.json
